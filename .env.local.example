# Copy this file to .env.local for local development (vercel dev) and
# add the same values to the Vercel project's Environment Variables for
# production. Never commit the real .env.local file.

# Supabase project (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the /admin tool
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
