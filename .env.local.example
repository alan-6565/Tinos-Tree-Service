# Copy this file to .env.local for local development (vercel dev) and
# add the same values to the Vercel project's Environment Variables for
# production. Never commit the real .env.local file.

# Supabase project (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the /admin tool
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Email (Resend: https://resend.com). Leave empty to keep email turned off.
RESEND_API_KEY=
# Sender, once tinostreeservice.net is verified in Resend.
EMAIL_FROM=Tino's Tree Service <invoices@tinostreeservice.net>

# Protects the daily payment-reminder job. Generate with: openssl rand -hex 32
CRON_SECRET=

# AI quick fill in the admin (Claude API key from platform.claude.com).
ANTHROPIC_API_KEY=
